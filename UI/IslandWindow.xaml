<Window x:Class="PrivacyIsland.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrivacyIsland"
        Width="124"
        Height="88"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality">
    <!--
        窗口比胶囊（76x40）四周各多留 24px，用于容纳 DropShadow 光晕（否则光晕会被窗口边缘裁剪）。
        胶囊在窗口内居中；窗口整体透明、鼠标穿透、不抢焦点。
    -->
    <Grid Background="Transparent">
        <Border x:Name="Capsule"
                Width="76"
                Height="40"
                CornerRadius="20"
                Background="#E61C1C1E"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect x:Name="Glow"
                                  Color="#FF34C759"
                                  BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.55" />
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CapsuleScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="CapsuleTranslate" Y="-60" />
                </TransformGroup>
            </Border.RenderTransform>

            <!-- 眼睛图标：纯 XAML 矢量绘制 -->
            <Viewbox Width="26" Height="26">
                <Canvas Width="24" Height="24">
                    <!-- 眼睛外轮廓 -->
                    <Path x:Name="EyeOutline"
                          Data="M1,12 C5,4 19,4 23,12 C19,20 5,20 1,12 Z"
                          Stroke="White"
                          StrokeThickness="1.8"
                          Fill="Transparent"
                          StrokeLineJoin="Round" />

                    <!-- 瞳孔 -->
                    <Ellipse x:Name="Pupil"
                             Canvas.Left="9"
                             Canvas.Top="9"
                             Width="6"
                             Height="6"
                             Fill="#34C759">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="PupilScale" CenterX="3" CenterY="3" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- 高光 -->
                    <Ellipse Canvas.Left="10.5"
                             Canvas.Top="10"
                             Width="1.6"
                             Height="1.6"
                             Fill="White" />
                </Canvas>
            </Viewbox>
        </Border>
    </Grid>
</Window>
